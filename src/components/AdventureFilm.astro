---
import {url} from '../lib/paths';
---
<div class="adventure-film">
 <img class="film-poster" src={url('media/home/adventure-poster-1280.webp?v=1.7b1')} srcset={`${url('media/home/adventure-poster-640.webp?v=1.7b1')} 640w, ${url('media/home/adventure-poster-1280.webp?v=1.7b1')} 1280w`} sizes="(min-width: 901px) 58vw, 100vw" alt="Hikers exploring sunlit rock formations in Cappadocia." width="1280" height="720" fetchpriority="high" decoding="async"/>
 <video id="adventure-film" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture poster={url('media/home/adventure-poster-1280.webp?v=1.7b1')}>
  <source data-src={url('media/home/adventure-loop.webm?v=1.7b1')} type="video/webm"/>
  <source data-src={url('media/home/adventure-loop.mp4?v=1.7b1')} type="video/mp4"/>
 </video>
 <div class="film-caption"><span>OUT THERE IS WHERE IT BEGINS.</span><span>TRAVEL / EXPLORE / PREPARE</span></div>
 <button id="film-toggle" type="button" aria-controls="adventure-film" hidden>Play adventure film</button>
 <p id="film-status" class="sr-only" role="status"></p>
</div>
<script>
const film=document.querySelector<HTMLVideoElement>('#adventure-film');
const toggle=document.querySelector<HTMLButtonElement>('#film-toggle');
const status=document.querySelector<HTMLElement>('#film-status');
if(film && toggle){
 const motion=window.matchMedia('(prefers-reduced-motion: reduce)');
 const mobile=window.matchMedia('(max-width: 900px)');
 const connection=(navigator as Navigator & {connection?:{saveData?:boolean;addEventListener?:(event:string,listener:()=>void)=>void}}).connection;
 let loaded=false;
 let userPaused=false;
 const label=()=>{toggle.textContent=film.paused?'Play adventure film':'Pause adventure film';};
 const load=()=>{
  if(loaded) return;
  film.querySelectorAll<HTMLSourceElement>('source').forEach(source=>{if(source.dataset.src) source.src=source.dataset.src;});
  film.muted=true;film.load();loaded=true;
 };
 const play=async()=>{
  load();
  try{await film.play();if(status) status.textContent='';}
  catch{if(status) status.textContent='The film could not play. You can continue exploring the page.';}
  label();
 };
 const release=()=>{
  film.pause();film.classList.remove('is-playing');
  film.querySelectorAll('source').forEach(source=>source.removeAttribute('src'));
  film.load();loaded=false;label();
 };
 const policy=()=>{
  if(motion.matches || mobile.matches || connection?.saveData){release();return;}
  if(!userPaused && !document.hidden) void play();
 };
 toggle.hidden=false;
 toggle.addEventListener('click',()=>{
  if(!film.paused){userPaused=true;film.pause();}
  else{userPaused=false;void play();}
 });
 film.addEventListener('playing',()=>{film.classList.add('is-playing');label();});
 film.addEventListener('pause',label);
 film.addEventListener('error',()=>{film.classList.remove('is-playing');if(status) status.textContent='The film is unavailable. The adventure image remains visible.';label();});
 motion.addEventListener('change',policy);mobile.addEventListener('change',policy);connection?.addEventListener?.('change',policy);
 document.addEventListener('visibilitychange',()=>{if(document.hidden) film.pause();else policy();});
 policy();
}
</script>
<style>
.adventure-film{position:relative;min-width:0;background:var(--night);overflow:hidden;min-height:620px}
.film-poster,video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
video{opacity:0}video.is-playing{opacity:1}
.film-caption{position:absolute;top:28px;left:28px;right:28px;display:flex;justify-content:space-between;gap:16px;color:var(--white);font-size:.57rem;letter-spacing:.12em;font-weight:700}
.film-caption span{background:var(--night);padding:6px 9px}
button{position:absolute;bottom:25px;left:28px;background:var(--night);color:var(--white);border:1px solid var(--frost);border-radius:3px;padding:12px 16px;min-height:44px;font-size:.75rem;cursor:pointer}
button:focus-visible{outline:3px solid var(--amber);outline-offset:4px}button[hidden]{display:none}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
@media(max-width:900px){.adventure-film{min-height:0;aspect-ratio:16/9}.film-caption{top:18px;left:20px;right:20px}.film-caption span+span{display:none}button{left:20px;bottom:18px}}
</style>
