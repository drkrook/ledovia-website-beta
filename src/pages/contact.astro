---
import Site from '../layouts/Site.astro';
import InquiryForm from '../components/InquiryForm.astro';
import {inquiryEmail,publicContactEmail} from '../lib/professional-inquiries';
---
<Site title="Contact Ledovia" description="Contact Ledovia with general questions or discuss planned Response and Government offerings. The inquiry form is a local preview only.">
<section class="contact-section"><div class="container"><div class="section-lead"><p class="eyebrow">GET IN TOUCH</p><h1>Contact Ledovia.</h1><p>Ask a general question or discuss the planned Response and Government directions. Professional offerings are in development and are not currently available.</p></div><div class="contact-grid"><section aria-labelledby="form-heading"><h2 id="form-heading">Prepare your inquiry</h2><InquiryForm/></section><aside class="email-panel" aria-labelledby="email-title"><p class="eyebrow">OPTION B / TELL US ABOUT YOUR CHALLENGE</p><h3 id="email-title">Start with an email.</h3><p>Describe your operational challenges, current workflows and requirements in as much detail as you’re comfortable sharing. Keep confidential or sensitive information out of email.</p><p class="email-address"><a href={`mailto:${publicContactEmail}`}>{publicContactEmail}</a></p><a class="button" href={inquiryEmail('response')}>Email about Response <span aria-hidden="true">→</span></a><a class="email-link" href={inquiryEmail('government')}>Email about Government <span aria-hidden="true">→</span></a><p class="email-note">These links open your email app with the relevant subject and a starting outline. Nothing is sent until you send it. Both offerings remain planned; an inquiry does not create a service commitment.</p></aside></div></div></section>
</Site>
<style>
.contact-section{background:var(--page-bg);border-block:1px solid var(--line);padding-block:85px}.contact-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:32px;align-items:start}.email-panel{min-width:0;padding:36px;background:var(--expedition);color:var(--frost);border-radius:4px}.email-panel .eyebrow{color:var(--amber);font-size:.6rem;letter-spacing:.12em}.email-panel h3{font-size:2rem}.email-panel p{font-size:.94rem}.email-panel .email-address{font-size:clamp(.95rem,1.4vw,1.18rem);font-weight:700;overflow-wrap:anywhere;margin:26px 0}.email-panel .button{font-size:.81rem;gap:18px;max-width:100%}.email-panel .email-link{display:block;font-size:.85rem;min-height:44px;text-decoration:underline;text-underline-offset:5px;padding-block:16px}.email-panel .email-note{font-size:.76rem;margin:20px 0 0}.email-panel a:focus-visible{outline-color:var(--focus)}
.section-lead{max-width:720px;margin-bottom:36px}.section-lead h1{font-size:clamp(2.3rem,6vw,4rem)}h2{font-size:1.3rem}.email-panel a{overflow-wrap:anywhere}.contact-section{padding-block:48px}
@media(max-width:800px){.contact-grid{grid-template-columns:1fr}.email-panel{padding:25px}}

.email-address a{text-decoration:underline;text-underline-offset:5px}
</style>
