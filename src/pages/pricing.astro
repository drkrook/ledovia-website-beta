.adventure-photo{position:relative;min-width:0;margin:0;min-height:580px}.adventure-photo img{display:block;width:100%;height:100%;position:absolute;inset:0;object-fit:cover;object-position:center 70%}.adventure-photo figcaption{position:absolute;bottom:22px;left:18px;right:18px;font-size:.71rem;background:var(--night);color:var(--frost);padding:9px 12px}
.preview-notice{border-bottom:1px solid var(--line);padding-block:25px}.preview-notice strong{display:block;font-size:.64rem;letter-spacing:.11em}.preview-notice p{font-size:.78rem;margin:6px 0 0;max-width:1000px}
.pricing-section{padding-block:72px}.section-lead{max-width:850px;margin-bottom:32px}.section-lead>p:not(.eyebrow){max-width:720px}.section-lead .eyebrow{margin-bottom:18px}
.package-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.package-card{display:flex;flex-direction:column;min-width:0;padding:28px 22px;background:var(--white);border:1px solid var(--line);border-top:3px solid var(--trail);border-radius:4px}.path-number{display:block;font-size:.59rem;letter-spacing:.09em;font-weight:650;margin-bottom:26px}.package-card .badge,.planned-badge{align-self:flex-start;display:inline-block;margin-bottom:18px;min-height:24px}.package-card h3{font-size:1.65rem;line-height:1.16;margin-bottom:18px}.package-card .card-promise{font-family:Georgia,serif;font-style:italic;font-size:1.1rem;line-height:1.5;min-height:3em;margin-bottom:24px}.package-price{font-size:2rem;line-height:1.3;font-weight:750;margin:0 0 22px}.price-period{font-size:.82rem;font-weight:500;white-space:nowrap}.price-label{font-size:.6rem;font-weight:750;letter-spacing:.07em;text-transform:uppercase;margin:0 0 5px}.package-card>p:not(.card-promise):not(.package-price):not(.price-label):not(.professional-price){font-size:.84rem;line-height:1.8}.package-card ul{padding-left:18px;font-size:.79rem;margin:0 0 20px}.package-card li{margin-bottom:9px}.package-card .package-note{font-size:.72rem!important;border-top:1px solid var(--line);padding-top:18px;margin-top:8px}.card-link{margin-top:auto;padding-top:15px;min-height:44px;font-size:.76rem;font-weight:750;text-decoration:underline;text-underline-offset:5px}.professional-card{background:var(--field);color:var(--frost);border-color:var(--field)}.professional-card .package-note{border-color:rgb(232 245 241 / .3)}.planned-badge{padding:4px 8px;background:var(--amber);color:var(--night);font-size:.6rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase}.professional-price{font-size:1rem;font-weight:650;line-height:1.6;margin:0 0 22px}.email-card-link{font-size:.73rem;text-decoration:underline;text-underline-offset:4px;padding-top:14px;min-height:44px}.professional-card a:focus-visible{outline-color:var(--amber)}
.billing-selector{display:flex;flex-wrap:wrap;gap:10px;border:0;padding:0;margin:0 0 10px;min-width:0}.billing-selector legend{font-size:.8rem;font-weight:700;margin-bottom:10px}.billing-selector label{display:flex;align-items:center;gap:10px;min-height:48px;padding:11px 18px;border:1px solid var(--trail);border-radius:3px;background:var(--white);cursor:pointer;font-size:.88rem;font-weight:650}.billing-selector label:has(input:checked){background:var(--expedition);color:var(--frost)}.billing-selector:disabled label{cursor:default}.billing-selector input{width:18px;height:18px;margin:0;accent-color:var(--trail)}.billing-selector input:focus-visible{outline:3px solid var(--amber);outline-offset:4px}.billing-selector label:has(input:focus-visible){outline:3px solid var(--trail);outline-offset:4px}.billing-status{font-size:.77rem;margin:0 0 30px;max-width:700px}
table{width:100%;border-collapse:collapse;table-layout:fixed;background:var(--white);font-size:.87rem;overflow-wrap:anywhere}.feature-column{width:44%}caption{text-align:left;font-size:.76rem;padding-bottom:14px}th,td{padding:19px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}thead{background:var(--expedition);color:var(--frost)}thead th{font-weight:650}tbody th{font-weight:700}tbody th span{display:block;font-weight:400;font-size:.76rem;line-height:1.6;margin-top:6px}.proposed-row{background:var(--mist)}
.qualification-list,.faq-list{max-width:950px}.qualification-list{margin-top:25px}.qualification-list details,.faq-list details{border-bottom:1px solid var(--line);padding-block:8px}summary{cursor:pointer;padding:12px 3px;min-height:44px;font-weight:650;line-height:1.6}.qualification-list p,.qualification-list li,.faq-list p{font-size:.87rem;line-height:1.85}.qualification-list ul{padding-left:22px}.qualification-list a,.image-credit a{text-decoration:underline;text-underline-offset:4px}.qualification-list a{overflow-wrap:anywhere}
.contact-section{background:var(--white);border-block:1px solid var(--line);padding-block:85px}.contact-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:32px;align-items:start}.email-panel{min-width:0;padding:36px;background:var(--expedition);color:var(--frost);border-radius:4px}.email-panel .eyebrow{color:var(--amber);font-size:.6rem;letter-spacing:.12em}.email-panel h3{font-size:2rem}.email-panel p{font-size:.94rem}.email-panel .email-address{font-size:clamp(.95rem,1.4vw,1.18rem);font-weight:700;overflow-wrap:anywhere;margin:26px 0}.email-panel .button{font-size:.81rem;gap:18px;max-width:100%}.email-panel .email-link{display:block;font-size:.85rem;min-height:44px;text-decoration:underline;text-underline-offset:5px;padding-block:16px}.email-panel .email-note{font-size:.76rem;margin:20px 0 0}.email-panel a:focus-visible{outline-color:var(--white)}
