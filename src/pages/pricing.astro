---
import Site from '../layouts/Site.astro';
import {url} from '../lib/paths';
import {getPriceExample} from '../lib/illustrative-pricing';
import {inquiryEmail} from '../lib/professional-inquiries';
const travelExample=getPriceExample('travel','monthly');
const survivalExample=getPriceExample('survival','monthly');
const shared=[
 {feature:'Explore with a map',detail:'Map viewing',qualification:'The app contains a map viewer and selectable layers. Coverage and third-party availability vary.'},
 {feature:'See what’s nearby',detail:'Resource-location information',qualification:'Available resource markers do not confirm safe access, potable water, or emergency-care availability.'},
 {feature:'Find your position',detail:'GPS positioning',qualification:'Requires permission and a compatible device/browser. Device and field acceptance testing remain necessary.'},
 {feature:'Keep meaningful places',detail:'Saved locations and bookmarks',qualification:'Entries stay in the current browser. They do not automatically synchronize across devices.'},
 {feature:'Prepare before you go',detail:'Offline map preparation',qualification:'Download the required area and data online first. Missing areas or zoom levels may be unavailable offline. Map imagery, resources and routing data are separate.'},
];
const questions=[
 {question:'Can I subscribe today?',answer:'No. Prices and billing periods are illustrative Beta examples. Final package contents, commercial pricing and launch availability are not approved. There is no checkout, subscription activation or free trial.'},
 {question:'What do I need before going offline?',answer:'Download your intended map area and required datasets while connected, inspect coverage and test that area offline on your device. Saved maps do not guarantee offline turn-by-turn guidance, current road conditions or safe passage.'},
 {question:'Will my saved places follow me to another device?',answer:'Local app entries stay in the browser where they were created. They do not automatically synchronize and can be lost if browser data is cleared or storage is evicted. Use the relevant backup tools and check what each export includes; do not assume every backup is encrypted.'},
 {question:'Are Response and Government available now?',answer:'No. These are planned offerings with capabilities in development. You can email Ledovia to describe your needs. An inquiry is not an offer of an operational service, delivery date or commercial commitment.'},
];
---
<Site title="Pricing & Packages" description="Every adventure deserves a plan. Explore Ledovia Travel and Survival illustrative Beta packages, and discuss planned Response and Government offerings.">
 <div class="pricing-page">
  <section class="container compact-intro" aria-labelledby="pricing-title"><h1 id="pricing-title">Choose Your Ledovia.</h1><p>Explore. Prepare. Respond.</p></section>
  <div class="container preview-notice"><strong>BETA PREVIEW — ILLUSTRATIVE PRICING ONLY</strong><p id="illustrative-disclaimer">Prices, billing periods, package features, and availability are examples for evaluation and may change before launch. Subscriptions and purchases are not currently available.</p></div>

  <section class="container pricing-section" id="packages" aria-labelledby="packages-title"><h2 class="sr-only" id="packages-title">Pricing &amp; packages</h2>
   <fieldset class="billing-selector" id="billing-selector" aria-describedby="illustrative-disclaimer" disabled><legend>Illustrative consumer billing period</legend><label><input type="radio" name="illustrative-billing" value="monthly" checked/><span>Monthly</span></label><label><input type="radio" name="illustrative-billing" value="annual"/><span>Annual</span></label></fieldset><p class="billing-status" id="billing-status" role="status" aria-live="polite" aria-atomic="true">Showing illustrative monthly prices for Travel and Survival.</p><noscript><p class="package-note">Monthly examples are shown. Enable JavaScript to compare annual examples; no subscriptions or purchases are available.</p></noscript>
   <div class="package-grid">
    <article class="package-card photo-card card-travel" aria-labelledby="travel-title"><div class="card-photo"><img src={url('images/pricing/cards/travel-800.webp')} srcset={`${url('images/pricing/cards/travel-480.webp')} 480w, ${url('images/pricing/cards/travel-800.webp')} 800w`} sizes="(min-width: 1101px) 23vw, (min-width: 651px) 46vw, 100vw" alt="Tropical island surrounded by turquoise ocean." width="800" height="534" loading="lazy" decoding="async"/></div><div class="card-content"><span class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m3 14 7-3V5a2 2 0 0 1 4 0v6l7 3v3l-7-2v5l3 2H7l3-2v-5l-7 2z"/></svg></span><span class="badge">In development</span><h3 id="travel-title">Ledovia Travel</h3><p class="price-label">Illustrative Beta price</p><p class="package-price"><span data-example-price="travel">{travelExample.amount}</span> <span class="price-period" data-price-period>{travelExample.suffix}</span></p><p class="card-description">More destinations. More family memories.</p><p class="package-note">Proposed direction · In development</p><a class="card-link" href="#comparison-title">Compare foundations <span aria-hidden="true">↗</span></a></div></article>
    <article class="package-card photo-card card-survival" aria-labelledby="survival-title"><div class="card-photo"><img src={url('images/pricing/cards/survival-800.webp')} srcset={`${url('images/pricing/cards/survival-480.webp')} 480w, ${url('images/pricing/cards/survival-800.webp')} 800w`} sizes="(min-width: 1101px) 23vw, (min-width: 651px) 46vw, 100vw" alt="A tent overlooking a forested mountain valley at sunset." width="800" height="501" loading="lazy" decoding="async"/></div><div class="card-content"><span class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m16 8-2.5 5.5L8 16l2.5-5.5z"/></svg></span><span class="badge">In development</span><h3 id="survival-title">Ledovia Survival</h3><p class="price-label">Illustrative Beta price</p><p class="package-price"><span data-example-price="survival">{survivalExample.amount}</span> <span class="price-period" data-price-period>{survivalExample.suffix}</span></p><p class="card-description">Wilderness days. A more prepared tomorrow.</p><p class="package-note">Proposed direction · In development</p><a class="card-link" href="#comparison-title">Compare foundations <span aria-hidden="true">↗</span></a></div></article>
    <article class="package-card photo-card card-response" aria-labelledby="response-title"><div class="card-photo"><img src={url('images/pricing/cards/response-800.webp')} srcset={`${url('images/pricing/cards/response-480.webp')} 480w, ${url('images/pricing/cards/response-800.webp')} 800w`} sizes="(min-width: 1101px) 23vw, (min-width: 651px) 46vw, 100vw" alt="Firefighters in helmets and reflective protective clothing handle a hose inside a fire-damaged structure." width="800" height="640" loading="lazy" decoding="async"/></div><div class="card-content"><span class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6z"/><path d="m8 12 3 3 5-6"/></svg></span><span class="planned-badge">Planned</span><h3 id="response-title">Ledovia Response</h3><p class="professional-price">Contact for Pricing — Planned Offering</p><p class="card-description">Preparedness conversations for business and field teams.</p><p class="package-note">Capabilities in development</p><a class="card-link" href={url('contact/?interest=response')}>Request Information <span aria-hidden="true">↗</span></a><a class="email-card-link" href={inquiryEmail('response')}>Email about Response</a></div></article>
    <article class="package-card photo-card card-government" aria-labelledby="government-title"><div class="card-photo"><img src={url('images/pricing/cards/government-800.webp')} srcset={`${url('images/pricing/cards/government-480.webp')} 480w, ${url('images/pricing/cards/government-800.webp')} 800w`} sizes="(min-width: 1101px) 23vw, (min-width: 651px) 46vw, 100vw" alt="A search-and-rescue team in helmets and orange protective clothing walks through collapsed buildings." width="800" height="640" loading="lazy" decoding="async"/></div><div class="card-content"><span class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8 9-5 9 5H3Zm2 2v8m5-8v8m4-8v8m5-8v8M3 21h18M4 18h16"/></svg></span><span class="planned-badge">Planned</span><h3 id="government-title">Ledovia Government</h3><p class="professional-price">Contact for Pricing — Planned Offering</p><p class="card-description">Future directions for agencies and public-sector needs.</p><p class="package-note">Capabilities in development</p><a class="card-link" href={url('contact/?interest=government')}>Request Information <span aria-hidden="true">↗</span></a><a class="email-card-link" href={inquiryEmail('government')}>Email about Government</a></div></article>
   </div><p class="card-imagery-note">Stock imagery illustrates each direction; it does not show Ledovia customers, teams, vehicles or agency affiliations. Package features remain proposed.</p>
  </section>

  <section class="container pricing-section" aria-labelledby="comparison-title"><div class="section-lead"><p class="eyebrow">A LITTLE PREPARATION GOES A LONG WAY</p><h2 id="comparison-title">Shared tools.<br/>Different journeys.</h2><p id="comparison-note">Travel and Survival share an app foundation. The tools below exist in app source; package allocation and device or field acceptance are not finalized.</p></div>
   <table aria-describedby="comparison-note"><caption>Shared app foundations and proposed consumer directions</caption><colgroup><col class="feature-column"/><col/><col/></colgroup><thead><tr><th scope="col">For your journey</th><th scope="col">Travel</th><th scope="col">Survival</th></tr></thead><tbody>{shared.map(row=><tr><th scope="row">{row.feature}<span>{row.detail}</span></th><td><span aria-hidden="true" class="foundation-check">✓</span><span class="sr-only">Source-confirmed common capability; not a finalized package entitlement</span></td><td><span aria-hidden="true" class="foundation-check">✓</span><span class="sr-only">Source-confirmed common capability; not a finalized package entitlement</span></td></tr>)}<tr class="proposed-row"><th scope="row">Make the trip your own<span>Proposed package direction</span></th><td>Planned<span class="sr-only">: destinations, exploration and family travel</span></td><td>Not finalized</td></tr><tr class="proposed-row"><th scope="row">Be ready when plans change<span>Proposed package direction</span></th><td>Not finalized</td><td>Planned<span class="sr-only">: preparedness checklists and local hazard records</span></td></tr></tbody></table>
   <div class="qualification-list"><details><summary>Before you head offline: coverage and safety</summary><ul>{shared.map(row=><li><strong>{row.detail}:</strong> {row.qualification}</li>)}</ul><p>These tools complement preparation. Always follow official guidance and use appropriate emergency services. They do not establish that a route, resource or location is safe.</p></details><details><summary>What is implemented, proposed or still being developed?</summary><p>“Shared foundation” means an implementation is present in source, not a purchased entitlement or field-tested guarantee. Travel and Survival specializations are proposed allocations. Complete offline training libraries, cloud family coordination, statewide vector packages and professional workflows remain planned or unverified.</p><p>Source references: <a href="https://github.com/drkrook/silent-compass-family-beta/blob/4114ed1f3b3f72fff3724b8fb671b9d228333cf0/index.html">maps and saved places</a>, <a href="https://github.com/drkrook/silent-compass-family-beta/blob/4114ed1f3b3f72fff3724b8fb671b9d228333cf0/package-manager.js">area preparation</a>, <a href="https://github.com/drkrook/silent-compass-family-beta/blob/4114ed1f3b3f72fff3724b8fb671b9d228333cf0/survival-hub.js">checklists</a>, and <a href="https://github.com/drkrook/silent-compass-family-beta/blob/4114ed1f3b3f72fff3724b8fb671b9d228333cf0/hazard-safety.js">local hazard reports</a>.</p></details></div>
  </section>



  <section class="container pricing-section faq-section" aria-labelledby="faq-title"><p class="eyebrow">A CLEAR VIEW BEFORE YOU GO</p><h2 id="faq-title">Good questions.<br/>Straight answers.</h2><div class="faq-list">{questions.map(({question,answer})=><details><summary>{question}</summary><p>{answer}</p></details>)}</div><p class="closing-tagline">Ready for the Adventure. Prepared for the Unexpected.</p><details class="image-credits"><summary>Photography credits</summary><p>Travel: <a href="https://www.pexels.com/photo/aerial-view-of-tropical-island-surrounded-by-turquoise-waters-28408412/">Asad Photo Maldives</a>. Survival: <a href="https://www.pexels.com/photo/tent-near-tree-2603681/">Nathan Moore</a>. Government: <a href="https://www.pexels.com/photo/group-of-paramedics-walking-through-a-demolished-city-16105713/">Faruk Tokluoğlu</a>. These photographs use the <a href="https://www.pexels.com/license/">Pexels License</a>. Response: <a href="https://www.pexels.com/photo/firefighters-in-action-at-a-disaster-site-36409935/">Bijen Amatya</a>, via Pexels, cropped. No endorsement or affiliation implied.</p></details></section>
 </div>
</Site>
<script>
import {getPriceExample, type BillingPeriod} from '../lib/illustrative-pricing';
const selector=document.querySelector<HTMLFieldSetElement>('#billing-selector');
const status=document.querySelector<HTMLElement>('#billing-status');
function displayPeriod(period: BillingPeriod) {
 document.querySelectorAll<HTMLElement>('[data-example-price]').forEach(output=>{
  const plan=output.dataset.examplePrice;
  if(plan!=='travel' && plan!=='survival') return;
  const price=getPriceExample(plan,period);
  output.textContent=price.amount;
  const suffix=output.closest('.package-price')?.querySelector<HTMLElement>('[data-price-period]');
  if(suffix) suffix.textContent=price.suffix;
 });
 if(status) status.textContent=`Showing illustrative ${period} prices for both packages. Subscriptions are not available.`;
}
function syncPeriod() {
 const selected=selector?.querySelector<HTMLInputElement>('input:checked');
 displayPeriod(selected?.value==='annual'?'annual':'monthly');
}
if(selector) {
 selector.addEventListener('change',syncPeriod);
 selector.disabled=false;
 syncPeriod();
 window.addEventListener('pageshow',syncPeriod);
}
</script>
<style>
.compact-intro{padding-top:32px}.compact-intro h1{font-size:clamp(2rem,5vw,3.2rem);margin-bottom:8px}.compact-intro p{margin-bottom:12px}.pricing-page .pricing-section{padding-top:18px}.pricing-page .preview-notice{padding-block:12px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}.foundation-check{font-size:1.4rem;color:var(--expedition);font-weight:700}



.preview-notice{border-bottom:1px solid var(--line);padding-block:25px}.preview-notice strong{display:block;font-size:.64rem;letter-spacing:.11em}.preview-notice p{font-size:.78rem;margin:6px 0 0;max-width:1000px}
.pricing-section{padding-block:72px}.section-lead{max-width:850px;margin-bottom:32px}.section-lead>p:not(.eyebrow){max-width:720px}.section-lead .eyebrow{margin-bottom:18px}
.package-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;align-items:stretch}
.package-card{--card-accent:var(--trail);display:flex;flex-direction:column;min-width:0;background:var(--white);border:1px solid var(--line);border-radius:7px;overflow:hidden}
.card-travel{--card-accent:var(--trail)}.card-survival{--card-accent:var(--amber)}.card-response{--card-accent:#287F98}.card-government{--card-accent:#2B645D}
.card-photo{aspect-ratio:5/4;overflow:hidden;background:var(--field)}.card-photo img{display:block;width:100%;height:100%;object-fit:cover}.card-travel .card-photo img{object-position:center 65%}.card-survival .card-photo img{object-position:58% center}.card-response .card-photo img,.card-government .card-photo img{object-position:center}
.card-content{display:flex;flex-direction:column;flex:1;position:relative;padding:44px 22px 25px;border-top:3px solid var(--card-accent)}
.card-icon{position:absolute;top:-28px;left:22px;display:grid;place-items:center;width:52px;height:52px;background:var(--white);color:var(--expedition);border:2px solid var(--card-accent);border-radius:50%;box-shadow:0 3px 10px rgb(7 25 28 / .12)}.card-icon svg{width:28px;height:28px}
.package-card .badge,.planned-badge{align-self:flex-start;display:inline-block;margin-bottom:16px;min-height:24px}.planned-badge{padding:4px 8px;background:var(--amber);color:var(--night);font-size:.6rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase}
.package-card h3{font-size:1.48rem;font-weight:750;line-height:1.15;text-transform:uppercase;letter-spacing:-.035em;margin-bottom:22px;min-height:2.3em}
.package-price{font-size:2.4rem;line-height:1.2;font-weight:750;margin:0 0 23px;min-height:2.4rem;white-space:nowrap}.price-period{font-size:.75rem;font-weight:500;white-space:nowrap}.price-label{font-size:.58rem;font-weight:750;letter-spacing:.07em;text-transform:uppercase;margin:0 0 5px}
.professional-price{font-size:1.06rem;font-weight:700;line-height:1.6;margin:0 0 23px;min-height:4.1rem}.card-description{font-size:.88rem;line-height:1.75;margin-bottom:18px;min-height:4.6em}.package-card .package-note{font-size:.7rem;border-top:1px solid var(--line);padding-top:16px;margin:0 0 19px}
.card-link{margin-top:auto;padding:12px 0;font-size:.77rem;font-weight:750;min-height:44px;text-decoration:underline;text-underline-offset:5px}.email-card-link{font-size:.73rem;text-decoration:underline;text-underline-offset:4px;padding-top:7px;min-height:36px}.card-imagery-note{font-size:.71rem;margin:20px 0 0;max-width:900px}

.billing-selector{display:flex;flex-wrap:wrap;gap:10px;border:0;padding:0;margin:0 0 10px;min-width:0}.billing-selector legend{font-size:.8rem;font-weight:700;margin-bottom:10px}.billing-selector label{display:flex;align-items:center;gap:10px;min-height:48px;padding:11px 18px;border:1px solid var(--trail);border-radius:3px;background:var(--white);cursor:pointer;font-size:.88rem;font-weight:650}.billing-selector label:has(input:checked){background:var(--expedition);color:var(--frost)}.billing-selector:disabled label{cursor:default}.billing-selector input{width:18px;height:18px;margin:0;accent-color:var(--trail)}.billing-selector input:focus-visible{outline:3px solid var(--amber);outline-offset:4px}.billing-selector label:has(input:focus-visible){outline:3px solid var(--trail);outline-offset:4px}.billing-status{font-size:.77rem;margin:0 0 30px;max-width:700px}
table{width:100%;border-collapse:collapse;table-layout:fixed;background:var(--white);font-size:.87rem;overflow-wrap:anywhere}.feature-column{width:44%}caption{text-align:left;font-size:.76rem;padding-bottom:14px}th,td{padding:19px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}thead{background:var(--expedition);color:var(--frost)}thead th{font-weight:650}tbody th{font-weight:700}tbody th span{display:block;font-weight:400;font-size:.76rem;line-height:1.6;margin-top:6px}.proposed-row{background:var(--mist)}
.qualification-list,.faq-list{max-width:950px}.qualification-list{margin-top:25px}.qualification-list details,.faq-list details{border-bottom:1px solid var(--line);padding-block:8px}summary{cursor:pointer;padding:12px 3px;min-height:44px;font-weight:650;line-height:1.6}.qualification-list p,.qualification-list li,.faq-list p{font-size:.87rem;line-height:1.85}.qualification-list ul{padding-left:22px}.qualification-list a,.image-credit a{text-decoration:underline;text-underline-offset:4px}.qualification-list a{overflow-wrap:anywhere}

.faq-section{padding-block:80px}.faq-list p{padding:10px 3px 8px;max-width:850px}.closing-tagline{margin:45px 0 0;font-family:Georgia,serif;font-style:italic;font-size:1.1rem}.image-credits{font-size:.72rem;margin-top:25px}.image-credits p{font-size:.75rem}.image-credits a{text-decoration:underline;text-underline-offset:4px}
@media(max-width:1100px){.package-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.card-content{padding-inline:28px}.card-icon{left:28px}}
@media(max-width:800px){}
@media(max-width:650px){.pricing-section{padding-block:54px}.package-grid{grid-template-columns:1fr;gap:20px}.card-content{padding-inline:26px}.card-icon{left:26px}.package-card h3{font-size:1.8rem;min-height:0}.card-description{min-height:0}.professional-price{min-height:0}.card-photo{aspect-ratio:5/4}.preview-notice{padding-block:22px}.preview-notice strong{font-size:.59rem}.preview-notice p{font-size:.75rem}.section-lead h2{font-size:2.1rem}.faq-section{padding-block:55px}table{font-size:.74rem}th,td{padding:14px 8px}tbody th span{font-size:.7rem}.feature-column{width:40%}}
</style>
