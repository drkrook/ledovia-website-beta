@media(max-width:1100px){.package-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.package-card{padding:30px}.adventure-grid{gap:30px}.contact-grid{gap:24px;grid-template-columns:1.2fr 1fr}.email-panel{padding:26px}}
@media(max-width:800px){.adventure-grid{grid-template-columns:1fr;gap:0}.adventure-copy{padding:60px 0 35px}.adventure-photo{min-height:390px;margin-bottom:30px}.adventure-photo img{object-position:center 72%}.contact-grid{grid-template-columns:1fr}.email-panel{padding:32px}.adventure-copy h1{font-size:clamp(2.8rem,7.5vw,4rem)}}
@media(max-width:650px){.pricing-section{padding-block:54px}.package-grid{grid-template-columns:1fr;gap:20px}.package-card{padding:28px}.package-card h3{font-size:1.9rem}.card-promise{min-height:0!important}.adventure-copy{padding-top:45px}.adventure-copy h1{font-size:clamp(2.65rem,10.8vw,3.6rem)}.intro-copy{font-size:1rem}.intro-actions{align-items:flex-start;flex-direction:column;gap:10px}.adventure-photo{min-height:380px}.preview-notice{padding-block:22px}.preview-notice strong{font-size:.59rem}.preview-notice p{font-size:.75rem}.section-lead h2{font-size:2.1rem}.contact-section{padding-block:55px}.email-panel{padding:25px}.email-panel h3{font-size:1.8rem}.faq-section{padding-block:55px}table{font-size:.74rem}th,td{padding:14px 8px}tbody th span{font-size:.7rem}.feature-column{width:40%}}
</style>
