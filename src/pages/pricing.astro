---
import Site from '../layouts/Site.astro';
import InquiryForm from '../components/InquiryForm.astro';
import {url} from '../lib/paths';
import {getPriceExample} from '../lib/illustrative-pricing';
import {inquiryEmail,publicContactEmail} from '../lib/professional-inquiries';
const travelExample=getPriceExample('travel','monthly');
const survivalExample=getPriceExample('survival','monthly');
const shared=[
 {feature:'Explore with a map',detail:'Map viewing',qualification:'The app contains a map viewer and selectable layers. Coverage and third-party availability vary.'},
 {feature:'See what’s nearby',detail:'Resource-location information',qualification:'Available resource markers do not confirm safe access, potable water, or emergency-care availability.'},
 {feature:'Find your position',detail:'GPS positioning',qualification:'Requires permission and a compatible device/browser. Device and field acceptance testing remain necessary.'},
 {feature:'Keep meaningful places',detail:'Saved locations and bookmarks',qualification:'Entries stay in the current browser. They do not automatically synchronize across devices.'},
 {feature:'Prepare before you go',detail:'Offline map preparation',qualification:'Download the required area and data online first. Missing areas or zoom levels may be unavailable offline. Map imagery, resources and routing data are separate.'},
];
const questions=[
 {question:'Can I subscribe today?',answer:'No. Prices and billing periods are illustrative Beta examples. Final package contents, commercial pricing and launch availability are not approved. There is no checkout, subscription activation or free trial.'},
 {question:'What do I need before going offline?',answer:'Download your intended map area and required datasets while connected, inspect coverage and test that area offline on your device. Saved maps do not guarantee offline turn-by-turn guidance, current road conditions or safe passage.'},
 {question:'Will my saved places follow me to another device?',answer:'Local app entries stay in the browser where they were created. They do not automatically synchronize and can be lost if browser data is cleared or storage is evicted. Use the relevant backup tools and check what each export includes; do not assume every backup is encrypted.'},
 {question:'Are Response and Government available now?',answer:'No. These are planned offerings with capabilities in development. You can email Ledovia to describe your needs. An inquiry is not an offer of an operational service, delivery date or commercial commitment.'},
];
---
<Site title="Pricing & Packages" description="Every adventure deserves a plan. Explore Ledovia Travel and Survival illustrative Beta packages, and discuss planned Response and Government offerings.">
 <div class="pricing-page">
  <section class="adventure-intro" aria-labelledby="pricing-title"><div class="container adventure-grid"><div class="adventure-copy"><p class="eyebrow">GOOD PLANS. GREAT STORIES.</p><h1 id="pricing-title">Every Adventure<br/><em>Deserves a Plan.</em></h1><p class="intro-copy">Explore farther. Make memories.<br/>Be ready for the unexpected.</p><div class="intro-actions"><a class="button" href="#packages">Find your path <span aria-hidden="true">↗</span></a><a class="intro-link" href="#professional-inquiries">For teams &amp; agencies <span aria-hidden="true">→</span></a></div></div><figure class="adventure-photo"><img src={url('images/pricing/family-hike-800.webp')} srcset={`${url('images/pricing/family-hike-480.webp')} 480w, ${url('images/pricing/family-hike-800.webp')} 800w, ${url('images/pricing/family-hike-1200.webp')} 1200w`} sizes="(max-width: 800px) 100vw, 46vw" alt="A parent and child with backpacks exploring a green forest trail together." width="1200" height="1500" fetchpriority="high" decoding="async"/><figcaption>Make room for the moments that matter.</figcaption></figure></div></section>
  <div class="container preview-notice"><strong>BETA PREVIEW — ILLUSTRATIVE PRICING ONLY</strong><p id="illustrative-disclaimer">Prices, billing periods, package features, and availability are examples for evaluation and may change before launch. Subscriptions and purchases are not currently available.</p></div>

  <section class="container pricing-section" id="packages" aria-labelledby="packages-title"><div class="section-lead"><p class="eyebrow">FOUR PATHS. ONE LEDOVIA.</p><h2 id="packages-title">Choose your next chapter.</h2><p>Family escapes. Days beyond the trailhead. A more prepared team. Explore the direction that fits your journey.</p></div>
   <fieldset class="billing-selector" id="billing-selector" aria-describedby="illustrative-disclaimer" disabled><legend>Illustrative consumer billing period</legend><label><input type="radio" name="illustrative-billing" value="monthly" checked/><span>Monthly</span></label><label><input type="radio" name="illustrative-billing" value="annual"/><span>Annual</span></label></fieldset><p class="billing-status" id="billing-status" role="status" aria-live="polite" aria-atomic="true">Showing illustrative monthly prices for Travel and Survival.</p><noscript><p class="package-note">Monthly examples are shown. Enable JavaScript to compare annual examples; no subscriptions or purchases are available.</p></noscript>
   <div class="package-grid">
    <article class="package-card" aria-labelledby="travel-title"><span class="path-number">01 / DISCOVER</span><span class="badge">In development</span><h3 id="travel-title">Ledovia Travel</h3><p class="card-promise">More places.<br/>More memories.</p><p class="price-label">Illustrative Beta price</p><p class="package-price"><span data-example-price="travel">{travelExample.amount}</span> <span class="price-period" data-price-period>{travelExample.suffix}</span></p><p>For adventure, destinations and family travel—from a weekend road trip to your next great escape.</p><ul><li>Explore places on the map</li><li>Keep destinations and bookmarks</li><li>Prepare selected areas before a trip</li></ul><p class="package-note">Proposed Travel direction. Final features and paid entitlements are not approved.</p><a class="card-link" href="#comparison-title">Explore the foundation <span aria-hidden="true">→</span></a></article>
    <article class="package-card" aria-labelledby="survival-title"><span class="path-number">02 / PREPARE</span><span class="badge">In development</span><h3 id="survival-title">Ledovia Survival</h3><p class="card-promise">Step outside.<br/>Think ahead.</p><p class="price-label">Illustrative Beta price</p><p class="package-price"><span data-example-price="survival">{survivalExample.amount}</span> <span class="price-period" data-price-period>{survivalExample.suffix}</span></p><p>For outdoor preparedness, offline preparation and practical readiness when plans change.</p><ul><li>Prepare your chosen map area</li><li>Organize readiness checklists</li><li>Record personal hazard observations</li></ul><p class="package-note">Proposed Survival direction. No field reliability or operational emergency service is promised.</p><a class="card-link" href="#comparison-title">Explore the foundation <span aria-hidden="true">→</span></a></article>
    <article class="package-card professional-card" aria-labelledby="response-title"><span class="path-number">03 / WORK TOGETHER</span><span class="planned-badge">Planned</span><h3 id="response-title">Ledovia Response</h3><p class="card-promise">For teams.<br/>For what’s next.</p><p class="professional-price">Contact for Pricing — Planned Offering</p><p>Planned solutions for businesses, field teams and organizational preparedness.</p><p class="package-note">Professional capabilities are in development. Tell us about your workflows and needs; availability and commitments are not established.</p><a class="card-link" href="#professional-inquiries">Request information <span aria-hidden="true">→</span></a><a class="email-card-link" href={inquiryEmail('response')}>Email about Response</a></article>
    <article class="package-card professional-card" aria-labelledby="government-title"><span class="path-number">04 / SERVE COMMUNITIES</span><span class="planned-badge">Planned</span><h3 id="government-title">Ledovia Government</h3><p class="card-promise">A shared view.<br/>A future direction.</p><p class="professional-price">Contact for Pricing — Planned Offering</p><p>Planned solutions for public-sector agencies and future operational needs.</p><p class="package-note">Professional capabilities are in development. Discuss requirements with us; no deployment readiness or commercial commitment is implied.</p><a class="card-link" href="#professional-inquiries">Request information <span aria-hidden="true">→</span></a><a class="email-card-link" href={inquiryEmail('government')}>Email about Government</a></article>
   </div>
  </section>

  <section class="container pricing-section" aria-labelledby="comparison-title"><div class="section-lead"><p class="eyebrow">A LITTLE PREPARATION GOES A LONG WAY</p><h2 id="comparison-title">Shared tools.<br/>Different journeys.</h2><p id="comparison-note">Travel and Survival share an app foundation. The tools below exist in app source; package allocation and device or field acceptance are not finalized.</p></div>
   <table aria-describedby="comparison-note"><caption>Shared app foundations and proposed consumer directions</caption><colgroup><col class="feature-column"/><col/><col/></colgroup><thead><tr><th scope="col">For your journey</th><th scope="col">Travel</th><th scope="col">Survival</th></tr></thead><tbody>{shared.map(row=><tr><th scope="row">{row.feature}<span>{row.detail}</span></th><td>Shared foundation</td><td>Shared foundation</td></tr>)}<tr class="proposed-row"><th scope="row">Make the trip your own<span>Proposed package direction</span></th><td>Destinations, exploration &amp; family travel</td><td>Allocation not finalized</td></tr><tr class="proposed-row"><th scope="row">Be ready when plans change<span>Proposed package direction</span></th><td>Allocation not finalized</td><td>Preparedness checklists &amp; local hazard records</td></tr></tbody></table>
   <div class="qualification-list"><details><summary>Before you head offline: coverage and safety</summary><ul>{shared.map(row=><li><strong>{row.detail}:</strong> {row.qualification}</li>)}</ul><p>These tools complement preparation. Always follow official guidance and use appropriate emergency services. They do not establish that a route, resource or location is safe.</p></details><details><summary>What is implemented, proposed or still being developed?</summary><p>“Shared foundation” means an implementation is present in source, not a purchased entitlement or field-tested guarantee. Travel and Survival specializations are proposed allocations. Complete offline training libraries, cloud family coordination, statewide vector packages and professional workflows remain planned or unverified.</p><p>Source references: <a href="https://github.com/drkrook/silent-compass-family-beta/blob/4114ed1f3b3f72fff3724b8fb671b9d228333cf0/index.html">maps and saved places</a>, <a href="https://github.com/drkrook/silent-compass-family-beta/blob/4114ed1f3b3f72fff3724b8fb671b9d228333cf0/package-manager.js">area preparation</a>, <a href="https://github.com/drkrook/silent-compass-family-beta/blob/4114ed1f3b3f72fff3724b8fb671b9d228333cf0/survival-hub.js">checklists</a>, and <a href="https://github.com/drkrook/silent-compass-family-beta/blob/4114ed1f3b3f72fff3724b8fb671b9d228333cf0/hazard-safety.js">local hazard reports</a>.</p></details></div>
  </section>

  <section class="contact-section" id="professional-inquiries" aria-labelledby="contact-title"><div class="container"><div class="section-lead"><p class="eyebrow">LET’S START WITH YOUR CHALLENGE</p><h2 id="contact-title">Your work. Your needs.<br/>A conversation worth having.</h2><p>Explore the planned Response and Government directions with Ledovia. We’re listening to the needs of business teams and public-sector agencies.</p></div><div class="contact-grid"><InquiryForm/><aside class="email-panel" aria-labelledby="email-title"><p class="eyebrow">OPTION B / TELL US ABOUT YOUR CHALLENGE</p><h3 id="email-title">Start with an email.</h3><p>Describe your operational challenges, current workflows and requirements in as much detail as you’re comfortable sharing. Keep confidential or sensitive information out of email.</p><p class="email-address">{publicContactEmail}</p><a class="button" href={inquiryEmail('response')}>Email about Response <span aria-hidden="true">↗</span></a><a class="email-link" href={inquiryEmail('government')}>Email about Government <span aria-hidden="true">→</span></a><p class="email-note">These links open your email app with the relevant subject and a starting outline. Nothing is sent until you send it. Both offerings remain planned; an inquiry does not create a service commitment.</p></aside></div></div></section>

  <section class="container pricing-section faq-section" aria-labelledby="faq-title"><p class="eyebrow">A CLEAR VIEW BEFORE YOU GO</p><h2 id="faq-title">Good questions.<br/>Straight answers.</h2><div class="faq-list">{questions.map(({question,answer})=><details><summary>{question}</summary><p>{answer}</p></details>)}</div><p class="closing-tagline">Ready for the Adventure. Prepared for the Unexpected.</p><p class="image-credit">Adventure photograph: <a href="https://www.pexels.com/photo/back-view-of-a-parent-and-a-child-in-a-forest-9849120/">Greg Betanov / Pexels</a>. Scenic stock imagery; no endorsement implied.</p></section>
 </div>
</Site>
<script>
import {getPriceExample, type BillingPeriod} from '../lib/illustrative-pricing';
const selector=document.querySelector<HTMLFieldSetElement>('#billing-selector');
const status=document.querySelector<HTMLElement>('#billing-status');
function displayPeriod(period: BillingPeriod) {
 document.querySelectorAll<HTMLElement>('[data-example-price]').forEach(output=>{
  const plan=output.dataset.examplePrice;
  if(plan!=='travel' && plan!=='survival') return;
  const price=getPriceExample(plan,period);
  output.textContent=price.amount;
  const suffix=output.closest('.package-price')?.querySelector<HTMLElement>('[data-price-period]');
  if(suffix) suffix.textContent=price.suffix;
 });
 if(status) status.textContent=`Showing illustrative ${period} prices for both packages. Subscriptions are not available.`;
}
function syncPeriod() {
 const selected=selector?.querySelector<HTMLInputElement>('input:checked');
 displayPeriod(selected?.value==='annual'?'annual':'monthly');
}
if(selector) {
 selector.addEventListener('change',syncPeriod);
 selector.disabled=false;
 syncPeriod();
 window.addEventListener('pageshow',syncPeriod);
}
</script>
<style>
