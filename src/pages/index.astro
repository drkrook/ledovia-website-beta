---
import Site from '../layouts/Site.astro';
import Button from '../components/Button.astro';
import AdventureFilm from '../components/AdventureFilm.astro';
import {url} from '../lib/paths';
const solutions=[
 {name:'Travel',image:'travel',height:534,alt:'A tropical island surrounded by turquoise water.',text:'Explore more with practical tools for every journey.',status:'In development',path:'pricing/#travel-title',cta:'Explore Travel'},
 {name:'Survival',image:'survival',height:501,alt:'A tent overlooking a forested mountain valley at sunset.',text:'Be prepared when the unexpected happens.',status:'In development',path:'pricing/#survival-title',cta:'Explore Survival'},
 {name:'Response',image:'response',height:640,alt:'Firefighters handling a hose inside a fire-damaged structure.',text:'Support professional disaster recovery and field operations.',status:'Planned offering',path:'contact/?interest=response',cta:'Discuss Response'},
 {name:'Government',image:'government',height:640,alt:'A search-and-rescue team walking through collapsed buildings.',text:'Explore preparedness solutions for agencies and communities.',status:'Planned offering',path:'contact/?interest=government',cta:'Discuss Government'},
];
---
<Site cinematic title="Adventure Starts With Confidence" description="Explore Ledovia’s developing travel, navigation and practical preparedness tools. Discover Travel and Survival, and discuss planned professional solutions.">
 <section class="cinematic-hero" aria-labelledby="hero-heading">
  <AdventureFilm/>
  <div class="brand-intro">
   <p class="eyebrow">LEDOVIA / YOUR NEXT CHAPTER</p>
   <h1 id="hero-heading">Adventure Starts<br/>With <em>Confidence.</em></h1>
   <p class="intro-copy">Adventure planning, navigation, and practical preparedness. Coming together for the journey ahead.</p>
   <p class="tagline">Ready for the Adventure.<br/>Prepared for the Unexpected.</p>
   <div class="intro-actions"><Button arrow="→" href="#solutions">Explore Solutions</Button><a class="secondary-link" href="#how-it-works">How It Works <span aria-hidden="true">→</span></a></div>
   <p class="development-note">Travel &amp; Survival in development. Professional offerings planned.</p>
  </div>
 </section>
 <section class="home-section" id="solutions" aria-labelledby="solutions-heading"><div class="container">
  <div class="section-heading"><div><p class="eyebrow">FOUR DIRECTIONS. ONE PURPOSE.</p><h2 id="solutions-heading">Solutions for<br/>Real-World Needs</h2></div><p>For the places you want to go.<br/>And the moments you need to be ready for.</p></div>
  <div class="photo-solutions">{solutions.map(solution=><article class="home-solution">
   <div class="solution-image-link"><img src={url(`images/pricing/cards/${solution.image}-800.webp`)} srcset={`${url(`images/pricing/cards/${solution.image}-480.webp`)} 480w, ${url(`images/pricing/cards/${solution.image}-800.webp`)} 800w`} sizes="(min-width: 1101px) 23vw, (min-width: 651px) 46vw, 100vw" alt={solution.alt} width="800" height={solution.height} loading="lazy" decoding="async"/></div>
   <div class="solution-copy"><p class="solution-status">{solution.status}</p><h3>{solution.name}</h3><p>{solution.text}</p><a class="solution-link" href={url(solution.path)}>{solution.cta} <span aria-hidden="true">→</span></a></div>
  </article>)}</div>
  <p class="qualification">Travel and Survival are proposed consumer directions; subscriptions and purchases are not available. Response and Government describe planned markets, not currently available professional services. Photography is illustrative and does not show Ledovia customers or imply endorsement.</p>
 </div></section>
 <section class="journey-overview home-section" id="how-it-works" aria-labelledby="overview-heading"><div class="container">
  <div class="overview-heading"><p class="eyebrow">A LITTLE PREPARATION. MORE POSSIBILITY.</p><h2 id="overview-heading">Plan thoughtfully.<br/>Explore with purpose.</h2><p>Ledovia’s developing app foundation connects mapping, saved places, and practical preparation. Here’s where to begin.</p></div>
  <ol class="journey-steps"><li><span aria-hidden="true">01</span><h3>Find your direction.</h3><p>Compare Travel and Survival, or tell us about a professional need. Package details and availability are still being developed.</p></li><li><span aria-hidden="true">02</span><h3>Prepare before you go.</h3><p>Plan your route, check conditions, and download required map areas while connected. Test your offline coverage on your device.</p></li><li><span aria-hidden="true">03</span><h3>Keep perspective.</h3><p>Use practical tools alongside your own preparation. Follow official guidance and contact emergency services when needed.</p></li></ol>
  <a class="inline-link" href={url('pricing/')}>Compare packages and technical qualifications <span aria-hidden="true">→</span></a>
 </div></section>
 <section class="home-closing"><div class="container"><p class="eyebrow">MAKE ROOM FOR WHAT’S NEXT.</p><h2>The journey is yours.<br/><em>Let’s get ready.</em></h2><Button arrow="→" href={url('pricing/')}>Explore the possibilities</Button><a class="closing-contact" href={url('contact/')}>Have a question? Get in touch <span aria-hidden="true">→</span></a></div></section>
 <div class="container home-credits"><details><summary>Film &amp; photography credits</summary><p>Adventure film: <a href="https://www.pexels.com/video/drone-footage-of-a-family-walking-on-mountain-8346124/">Mikhail Nilov</a>; family forest walk and camping: <a href="https://www.pexels.com/video/family-walking-together-in-a-forest-9242518/">Ron Lach</a> and <a href="https://www.pexels.com/video/happy-family-in-a-camping-site-9210957/">Ron Lach</a>. Poster extracted from the licensed film. Solution photography: Asad Photo Maldives, Nathan Moore, Bijen Amatya, and Faruk Tokluoğlu; original sources linked in <a href={url('pricing/#faq-title')}>Pricing photography credits</a>. All under the <a href="https://www.pexels.com/license/">Pexels License</a>. No endorsement implied. No product-interface footage is shown.</p></details></div>
</Site>
<style>
.cinematic-hero{display:grid;grid-template-columns:58fr 42fr;background:var(--night);color:var(--frost)}
.brand-intro{padding:clamp(35px,4vw,72px);align-self:center;min-width:0}
.brand-intro .eyebrow{color:var(--amber);font-size:.62rem;margin-bottom:22px}
h1{font-size:clamp(2.5rem,3.8vw,4.4rem);line-height:1.08;color:var(--white);margin-bottom:24px}h1 em{color:var(--amber)}
.intro-copy{font-size:1rem;line-height:1.8;max-width:440px}.tagline{font-size:.9rem;line-height:1.8;border-left:2px solid var(--amber);padding-left:18px;margin:24px 0 30px}
.intro-actions{display:flex;align-items:flex-start;flex-wrap:wrap;gap:16px}.secondary-link{padding-block:15px;min-height:48px;font-size:.82rem;text-decoration:underline;text-underline-offset:5px}
.brand-intro a:focus-visible,.home-closing a:focus-visible{outline-color:var(--amber)}.development-note{font-size:.69rem;margin:22px 0 0;color:var(--frost)}
.home-section{padding:88px 0}.section-heading h2{font-size:clamp(2.1rem,3.5vw,3.5rem)}
.photo-solutions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.home-solution{background:var(--white);border:1px solid var(--line);border-radius:5px;overflow:hidden;display:flex;flex-direction:column;min-width:0}
.solution-image-link{display:block;aspect-ratio:5/4;overflow:hidden;background:var(--field)}.solution-image-link img{display:block;width:100%;height:100%;object-fit:cover}.solution-copy{padding:26px;display:flex;flex-direction:column;flex:1}.solution-status{font-size:.57rem;text-transform:uppercase;letter-spacing:.1em;font-weight:750;color:var(--trail);margin-bottom:13px}.solution-copy h3{font-size:1.75rem;margin-bottom:16px}.solution-copy>p:not(.solution-status){font-size:.87rem;line-height:1.8}.solution-link{display:flex;justify-content:space-between;gap:12px;align-items:center;min-height:48px;margin-top:auto;font-size:.78rem;font-weight:750;text-decoration:underline;text-underline-offset:5px}
.qualification{font-size:.74rem;line-height:1.9;max-width:1000px;margin:24px 0 0}
.journey-overview{background:var(--white);border-block:1px solid var(--line)}.overview-heading{max-width:720px}.overview-heading>p:last-child{max-width:600px}.journey-steps{list-style:none;padding:0;margin:44px 0 30px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px}.journey-steps li{border-top:2px solid var(--trail);padding-top:20px}.journey-steps span{font-size:.75rem;letter-spacing:.1em}.journey-steps h3{font-size:1.5rem;margin-top:18px}.journey-steps p{font-size:.88rem}
.home-closing{background:var(--expedition);color:var(--frost);padding:74px 0;text-align:center}.home-closing .eyebrow,.home-closing em{color:var(--amber)}.closing-contact{display:block;margin:24px auto 0;padding:8px;min-height:44px;font-size:.83rem;text-decoration:underline;text-underline-offset:5px}
.home-credits{padding-block:22px;font-size:.73rem}.home-credits summary{cursor:pointer;padding-block:10px;min-height:44px}.home-credits p{max-width:1000px}.home-credits a{text-decoration:underline;text-underline-offset:3px}
@media(max-width:1100px){.photo-solutions{grid-template-columns:repeat(2,minmax(0,1fr))}.brand-intro{padding:34px 28px}h1{font-size:2.7rem}.journey-steps{gap:24px}}
@media(max-width:900px){.cinematic-hero{grid-template-columns:1fr}.brand-intro{padding:38px max(24px,6vw)}h1{font-size:clamp(2.7rem,7vw,4rem)}.intro-copy{max-width:600px}.tagline{margin-block:22px}.home-section{padding:62px 0}}
@media(max-width:650px){.photo-solutions,.journey-steps{grid-template-columns:1fr}.brand-intro{padding:32px 20px 36px}h1{font-size:clamp(2.4rem,10vw,3.3rem)}.intro-copy{font-size:.94rem}.tagline{font-size:.84rem}.development-note{font-size:.66rem}.home-section{padding-block:55px}.solution-copy{padding:24px}.journey-steps{gap:22px;margin-top:32px}.journey-steps h3{margin-bottom:14px}.home-closing{padding:55px 0}}
</style>
