---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {url} from '../lib/paths';
import '../styles/global.css';
interface Props {title?:string;description?:string;}
const {title='Adventure Awaits. Be Ready for It.',description='Discover Ledovia’s developing vision for family travel, outdoor exploration, and preparedness.'}=Astro.props;
const canonical=new URL(Astro.url.pathname.endsWith('/404/') ? url('404.html') : Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} | LEDOVIA</title><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><link rel="canonical" href={canonical}/><meta property="og:title" content={`${title} | LEDOVIA`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta name="theme-color" content="#113E41"/><link rel="icon" type="image/svg+xml" href={url('favicon.svg')}/></head><body><a class="skip" href="#main">Skip to content</a><div class="beta-bar"><span class="beta-label">BETA</span> A new journey is taking shape. <span class="beta-extra">Products in development.</span></div><Header/><main id="main" tabindex="-1"><slot/></main><Footer/></body></html>
